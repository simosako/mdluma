# Rust build output
/target/

# Rust tool backups
**/*.rs.bk

# Windows build artifacts
*.exe
*.pdb
*.ilk
*.obj
*.lib
*.dll
*.exp

# Local environment and editor state
.env
.env.*
.vscode/
.idea/
*.swp
*.swo

# OS generated files
Thumbs.db
Desktop.ini
.DS_Store

# Vendor (Sciter SDK) — only specific files needed for build and compliance are unignored
vendor/
!vendor/sciter-js-sdk-main/
!vendor/sciter-js-sdk-main/bin/
!vendor/sciter-js-sdk-main/bin/windows/
!vendor/sciter-js-sdk-main/bin/windows/x64/
!vendor/sciter-js-sdk-main/bin/windows/x64/sciter.dll
!vendor/sciter-js-sdk-main/LICENSE
!vendor/sciter-js-sdk-main/SCITER-ENGINE-EULA.md

# CocoIndex Code (ccc)
/.cocoindex_code/

# OpenCode
.opencode/
opencode.json
